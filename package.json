{
  "name": "mlai-plane-edge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.5",
  "engines": {
    "bun": ">=1.3.5"
  },
  "scripts": {
    "dev": "wrangler dev --env staging",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "cf-typegen": "wrangler types --env production",
    "deploy:dry-run": "wrangler deploy --dry-run --env production",
    "check": "bun run typecheck && bun run test && bun run deploy:dry-run"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "latest",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0",
    "wrangler": "latest"
  }
}
